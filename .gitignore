.DS_Store

# Xcode user state
xcuserdata/
*.hmap

# SwiftPM build products and local state, anywhere in the tree
.build/
.swiftpm/

# Corpus pipeline working directory (reproducible; only overrides/ is worth committing)
corpus/*
!corpus/overrides/

# Traces `make trace` records
traces/

# Python bytecode, from running Tools/trace/trace.py
__pycache__/

# Benchmark baselines are this machine's numbers
Tools/benchmarks/.benchmarkBaselines/

# Generated by XcodeGen from project.yml; regenerate rather than commit
RFCReader.xcodeproj/
App/RFCReader/Info.plist
App/RFCReader/RFCReader.entitlements
App/SafariExtension/Info.plist
App/SafariExtension/RFCReaderSafari.entitlements

# Claude Code: worktrees and personal settings stay local; skills and settings.json are shared
.claude/worktrees/
.claude/settings.local.json

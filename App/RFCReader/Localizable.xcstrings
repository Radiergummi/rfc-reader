  "strings" : {
    "%@ %@ %@" : {
      "comment" : "A draft's relation, its name and its stage",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ %2$@ %3$@"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ %2$@ %3$@"
          }
        }
      }
    },
    "%@ couldn't be exported: %@" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ konnte nicht exportiert werden: %2$@"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ couldn't be exported: %2$@"
          }
        }
      }
    },
    "%@ didn't load: %@" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ wurde nicht geladen: %2$@"

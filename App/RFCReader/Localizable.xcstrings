    "%@ %@ %@" : {
      "comment" : "A draft's relation, its name and its stage",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ %2$@ %3$@"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ %2$@ %3$@"
          }
        }
      }
    },
    "%@ didn't load: %@" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ wurde nicht geladen: %2$@"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ didn't load: %2$@"
          }
        }
      }
    },
    "%@ doesn't say which of its references are normative, so none of them are followed." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ sagt nicht, welche seiner Referenzen normativ sind, daher wird keine von ihnen weiterverfolgt."
          }
        }
      }
    },
    "%@ has no section %@." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {

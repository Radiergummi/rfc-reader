    "Text Size: %lld" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Textgröße: %lld"
          }
        }
      }
    },
    "The %lld RFCs not yet indexed are downloaded when the network is not metered, or read from the legacy pack, and only their text is kept. You can stop at any time and go on later." : {
      "localizations" : {
        "de" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Der %lld noch nicht indizierte RFC wird geladen, sobald das Netzwerk nicht getaktet ist, oder aus dem Legacy-Paket gelesen, und nur sein Text wird behalten. Du kannst jederzeit anhalten und später weitermachen."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Die %lld noch nicht indizierten RFCs werden geladen, sobald das Netzwerk nicht getaktet ist, oder aus dem Legacy-Paket gelesen, und nur ihr Text wird behalten. Du kannst jederzeit anhalten und später weitermachen."
                }
              }
            }
          }
        },
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "The %lld RFC not yet indexed is downloaded when the network is not metered, or read from the legacy pack, and only its text is kept. You can stop at any time and go on later."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "The %lld RFCs not yet indexed are downloaded when the network is not metered, or read from the legacy pack, and only their text is kept. You can stop at any time and go on later."
                }
              }
            }
          }
        }
      }
    },
    "The RFC index isn't available. Open RFC Reader to load it, then try again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der RFC-Index ist nicht verfügbar. Öffne RFC Reader, um ihn zu laden, und versuche es dann erneut."
          }
        }
      }
    },
    "The citation index couldn't be read." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Zitationsindex konnte nicht gelesen werden."
          }
        }
      }
    },
    "The document hasn't loaded." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Dokument wurde noch nicht geladen."
          }
        }
      }
    },
    "The document is unavailable, so its highlights cannot be shown in it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Dokument ist nicht verfügbar, daher können seine Markierungen nicht darin gezeigt werden."
          }
        }
      }
    },
    "The documents this one cites normatively, in the order to read them." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Dokumente, die dieses normativ zitiert, in der Reihenfolge, in der sie zu lesen sind."
          }
        }
      }
    },
    "The errata not marked on any section" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Errata, die bei keinem Abschnitt markiert sind"
          }
        }
      }
    },
    "The export was canceled." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Export wurde abgebrochen."
          }
        }
      }
    },
    "The index keeps only the RFCs on this device, and search finds text in those. Index All RFCs downloads the rest again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Index behält nur die RFCs auf diesem Gerät, und die Suche findet Text in diesen. „Alle RFCs indizieren“ lädt den Rest erneut."
          }
        }
      }
    },
    "The list of every RFC is downloaded once, then kept up to date." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Liste aller RFCs wird einmal geladen und danach aktuell gehalten."

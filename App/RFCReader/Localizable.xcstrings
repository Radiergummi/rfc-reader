    "Otherwise lists are denser, and the status is still read by VoiceOver." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sonst sind Listen dichter, und VoiceOver liest den Status weiterhin vor."
          }

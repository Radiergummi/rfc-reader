{
  "manifest_version": 3,
  "name": "RFC Reader",
  "description": "Opens RFCs from rfc-editor.org and Datatracker in RFC Reader.",
  "version": "0.1.0",
  "icons": {
    "48": "images/icon.svg",
    "96": "images/icon.svg",
    "128": "images/icon.svg",
    "256": "images/icon.svg",
    "512": "images/icon.svg"
  },
  "background": {
    "scripts": ["background.js"],
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": "images/toolbar-icon.svg"
  },
  "content_scripts": [
    {
      "matches": [
        "*://rfc-editor.org/rfc/*",
        "*://www.rfc-editor.org/rfc/*",
        "*://datatracker.ietf.org/doc/*"
      ],
      "js": ["redirect.js"],
      "run_at": "document_start"
    }
  ],
  "permissions": ["nativeMessaging", "storage"],
  "host_permissions": [
    "*://rfc-editor.org/*",
    "*://www.rfc-editor.org/*",
    "*://datatracker.ietf.org/*"
  ]
}

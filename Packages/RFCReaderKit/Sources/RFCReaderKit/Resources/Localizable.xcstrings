    "Documents about the policies of the RFC Series itself." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dokumente über die Regeln der RFC-Reihe selbst."
          }
        }
      }
    },
    "Documents from the Internet Architecture Board, which oversees the architecture of the Internet and the IETF's standards process." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dokumente des Internet Architecture Board, das die Architektur des Internets und den Standardisierungsprozess der IETF beaufsichtigt."
          }
        }
      }
    },
    "Documents from the Internet Engineering Task Force, most of them written in its working groups and approved by the IESG." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dokumente der Internet Engineering Task Force, die meisten in ihren Working Groups geschrieben und von der IESG verabschiedet."
          }
        }
      }
    },
    "Documents from the research groups of the Internet Research Task Force, which studies longer-term questions than the IETF." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dokumente der Research Groups der Internet Research Task Force, die längerfristigen Fragen nachgeht als die IETF."
          }
        }
      }
    },
    "Documents published outside the IETF's process, reviewed and approved by the Independent Submissions Editor." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dokumente, die außerhalb des Prozesses der IETF veröffentlicht werden, geprüft und freigegeben vom Independent Submissions Editor."
          }
        }
      }
    },

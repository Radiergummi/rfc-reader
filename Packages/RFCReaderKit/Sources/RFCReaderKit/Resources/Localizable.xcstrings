{
  "sourceLanguage" : "en",
  "strings" : {
    "%@ %@, %@." : {
      "comment" : "A draft's relation to the RFC, its name and its stage",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ %2$@, %3$@."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ %2$@, %3$@."
          }
        }
      }
    },
    "%@ %@, in the RFC Editor queue." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ %2$@, in der Warteschlange des RFC Editor."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ %2$@, in the RFC Editor queue."
          }
        }
      }
    },
    "%@ %@, revision %@ from %@, %@" : {
      "comment" : "A draft's relation to the RFC, its name, its revision, its month and its stage",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",

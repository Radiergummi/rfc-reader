    },
    "All RFCs" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle RFCs"
          }
        }
      }
    },
    "An IETF group chartered for one piece of work within an area, such as HTTP or QUIC." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine IETF-Gruppe mit einem Auftrag für eine Aufgabe innerhalb einer Area, etwa HTTP oder QUIC."
          }
        }
      }
    },
    "An Informational RFC can come from any stream and need not reflect any community consensus." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Informational RFC kann aus jedem Stream kommen und muss keinen Konsens der Community wiedergeben."
          }
        }
      }
    },
    "An RFC never changes once published: a correction is recorded as an erratum, and a revision is a new RFC." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein RFC ändert sich nach der Veröffentlichung nie: Eine Korrektur wird als Erratum erfasst, eine Überarbeitung ist ein neuer RFC."
          }
        }
      }
    },
    "An erratum is verified when the body that approved the document confirms it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Erratum ist bestätigt, wenn die Stelle, die das Dokument verabschiedet hat, es anerkennt."
          }
        }
      }
    },
    "Anyone can take part, mostly on its mailing list, and its decisions are made by rough consensus." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeder kann mitmachen, meist über die Mailingliste, und Entscheidungen fallen im Rough Consensus."
          }
        }
      }
    },

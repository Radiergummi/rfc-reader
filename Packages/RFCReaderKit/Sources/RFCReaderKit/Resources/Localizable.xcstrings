      }
    },
    "%@ is in IANA's registry, which names no RFC for it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ steht in der Registry der IANA, die keinen RFC dafür nennt."

            "value" : "Stream"
          }
        }
      }
    },
    "Streams were defined in 2007, by RFC 4844, and earlier RFCs carry no stream of their own." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Streams wurden 2007 mit RFC 4844 festgelegt, und frühere RFCs haben keinen eigenen Stream."
          }
        }
      }
    },
    "Submitted for publication" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zur Veröffentlichung eingereicht"
          }
        }

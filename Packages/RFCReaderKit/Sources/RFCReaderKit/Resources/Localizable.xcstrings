    "Sections %@" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abschnitte %@"
          }
        }
      }
    },
    "Sections whose heading matches, in the RFCs the app holds, or in every RFC once Index All RFCs has run." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abschnitte, deren Überschrift passt, in den RFCs, die die App hat, oder in allen RFCs, sobald „Alle RFCs indizieren“ gelaufen ist."
          }
        }
      }
    },
    "Short" : {
